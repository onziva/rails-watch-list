<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Watch List" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="container">
        <%= link_to root_path, class: "navbar-brand" do %>
          <i class="fa-solid fa-clapperboard me-2"></i>Watch List
        <% end %>
        <%= link_to new_list_path, class: "btn btn-outline-light btn-sm" do %>
          <i class="fa-solid fa-plus me-1"></i> Nouvelle liste
        <% end %>
      </div>
    </nav>

    <%= yield :hero %>

    <div class="container py-4">
      <%= yield %>
    </div>
  </body>
</html>
